							id=2408;
							type="ModuleCreateDiaryRecord_F";
							class CustomAttributes
							{
								class Attribute0
								{
									property="ModuleCreateDiaryRecord_F_PresetTitle";
									expression="_this setVariable ['PresetTitle',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="Situation";
										};
									};
								};
								class Attribute1
								{
									property="ModuleCreateDiaryRecord_F_Title";
									expression="_this setVariable ['Title',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="";
										};
									};
								};
								class Attribute2
								{
									property="ModuleCreateDiaryRecord_F_Description";
									expression="_this setVariable ['Description',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="<font face='PuristaBold' color='#FFFFFF' size='22'>A PSEUDO-HISTORICAL RECREATION</font> " \n "<font face='PuristaBold' color='#fce300' size='15'>SITUATION</font> " \n "<br/> " \n "The ongoing war between the United States and Russia has finally reached Sumava. Following the escalation of hostilities across Europe, U.S. European Command (EUCOM) has deployed several Army divisions into the region to establish a defensive presence and prevent further Russian advances. " \n "<br/><br/> " \n "Despite American claims that the deployment is necessary for regional security, the occupation has been met with widespread backlash from the local population. " \n "<br/><br/> " \n "The Nationalist Party has taken advantage of the situation, organizing local resistance cells and recruiting former soldiers and disgruntled civilians into its ranks. " \n "<br/><br/> " \n "Our latest intelligence has identified an American propaganda broadcasting post operating near the local settlement of Vlkonice. The facility is being used to distribute occupation-sponsored broadcasts and promote cooperation with the American administration.  " \n "<br/><br/> " \n "The installation is currently protected by a relatively light security force, although personnel numbers around the facility remain significant. With American forces increasingly occupied by the Russian advance, this presents an opportunity for the resistance to disrupt their operations and demonstrate that the occupation cannot operate without opposition. " \n "<br/><br/> " \n "<font face='PuristaBold' color='#fce300' size='15'>ENEMY</font> " \n "<br/> " \n "U.S. forces constitute the primary occupying force in the region. " \n "<br/><br/> " \n "The propaganda post is lightly guarded, but the number of personnel present should not be underestimated. Several American soldiers are assigned to security and administrative duties around the installation. " \n "<br/><br/> " \n "An infantry patrol is currently operating in the nearby town. Its exact strength and composition are unknown. There may be more patrols around the post. " \n "<br/><br/> " \n "An American armored patrol has also been reported moving along the surrounding road network. The patrol consists of armored vehicles and may respond to reports of hostile activity. " \n "<br/><br/> " \n "American reinforcements stationed elsewhere in the region may be dispatched if the situation remains escalating. " \n "<br/><br/> " \n "<font face='PuristaBold' color='#fce300' size='15'>MISSION</font> " \n "<br/> " \n "Your group is tasked with conducting an assault against the American broadcasting post. " \n "<br/><br/> " \n "The primary objective is to destroy the radio tower and clear out the post. " \n "<br/><br/> " \n "Once the objective has been completed, your group is to withdraw from the area and return to the HQ. " \n "<br/><br/> " \n "Remaining at the installation for an extended period is strongly discouraged. Friendly militias will move in to assist from the east.  " \n "<br/><br/> " \n "The operation is intended to demonstrate that the Nationalist Party is active and capable of striking occupation targets. ";
										};
									};
								};
								class Attribute3
								{
