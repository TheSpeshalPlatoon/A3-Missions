};

class CfgORBAT {
//1st Inf Brigade 3000
//    1st Inf Battalion
//    2nd Inf Battalion x
//2nd Inf Brigade 3000 (Reserves)
//    3nd Inf Battalion
//    4th Inf Battalion
//1st Cav Brigade 3000
//    1st Cav Battalion x
