class CfgNotifications {
	class ItemUnlocked {title = "Arsenal Items Unlocked"; iconPicture = "\A3\ui_f\data\IGUI\Cfg\Actions\gear_ca.paa"; description = "%1"; priority = 5};
	class AddIntel {title = "Intel Acquired"; iconText = "+%2"; description = "Total Intel: %1"; priority = 7};
