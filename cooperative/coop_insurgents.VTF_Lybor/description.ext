author = "Goosey"; onLoadName = "Insurgents"; onLoadMission = "While the majority of the Russian forces in Chernarus are advancing into South Zagoria, your battlegroup has been tasked with pacifying the countryside. The Nationalist guerrillas have intensified their attacks and they must be neutralized."; class Header {gameType = COOP}; loadScreen = __EVAL(selectRandom["overview.jpg"]); 

