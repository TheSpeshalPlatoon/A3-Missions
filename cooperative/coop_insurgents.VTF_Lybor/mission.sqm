	class Entities
	{
		items=7;
		class Item0
		{
			dataType="Layer";
			name="mission";
			class Entities
			{
				items=24;
				class Item0
				{
					dataType="Layer";
					name="!info";
					class Entities
					{
						items=8;
						class Item0
						{
							dataType="Marker";
							position[]={723.20001,41.855,1099.7159};
							name="staging";
							text="Insertion Point";
							type="respawn_inf";
							colorName="ColorEAST";
							id=56;
							atlOffset=0.0015602112;
						};
						class Item1
						{
							dataType="Logic";
							class PositionInfo
							{
								position[]={2000.3768,75.266731,2499.6846};
								angles[]={0.019996032,0,0.02666023};
							};
							areaSize[]={2000.462,0,2500.3862};
							areaIsRectangle=1;
							flags=1;
							id=3094;
							type="ModuleCoverMap_F";
							atlOffset=34.884068;
						};
						class Item2
						{
							dataType="Logic";
							class PositionInfo
							{
								position[]={958.78198,38.922173,1298.691};
								angles[]={6.0426092,0,0.074525557};
							};
							id=3352;
							type="ModuleCreateDiaryRecord_F";
							class CustomAttributes
							{
								class Attribute0
								{
									property="ModuleCreateDiaryRecord_F_PresetTitle";
									expression="_this setVariable ['PresetTitle',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="Situation";
										};
									};
								};
								class Attribute1
								{
									property="ModuleCreateDiaryRecord_F_Title";
									expression="_this setVariable ['Title',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="Briefing";
										};
									};
								};
								class Attribute2
								{
									property="ModuleCreateDiaryRecord_F_Description";
									expression="_this setVariable ['Description',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="<font face='PuristaBold' color='#fce300' size='15'>SITUATION</font> " \n "<br/> " \n "Militia groups led by Aleksei Privalov, have been systematically ambushing supply routes for the last three weeks and they're steadily getting more daring. The local guerilla leader is present at the airfield with a group of CDF Army officers, the capture of this leader is our mission today. " \n "<br/><br/> " \n "About two hours ago, a Supply Convoy disappeared while moving east towards South Zagoria. No distress call was received. Reconnaissance remains intermittent due to the terrain. " \n "<br/><br/> " \n "Division will not authorize the assault on Privalov's airfield until the fate of that convoy is determined and any recoverable supplies are secured. The warlord is known to use captured logistics as bargaining chips and propaganda. " \n "<br/><br/> " \n "Privalov is to be captured alive if possible as it will speed up the pacification of the region. " \n " " \n "<br/><img image='warlord.paa' width='300' height='150'/><br/> " \n "(Picture from a Telegram group)<br/><br/> " \n " " \n " " \n "<font face='PuristaBold' color='#fce300' size='15'>ENEMY</font> " \n "<br/>As far as GRU estimates know, we are dealing with a relatively small and disorganized group of civilians with light paramilitary support. They should not prove difficult to pacify<br/><br/> " \n "The insurgents are using the surrounding farms and towns to hide weapons and heavy equipment. " \n "<br/><br/> " \n " " \n "<font face='PuristaBold' color='#fce300' size='15'>MISSION</font> " \n "<br/> " \n "Your platoon is to locate the missing Supply Convoy and then move in to capture Warlord Privalov alongside Second Platoon. If the warlord and officers are not present there, you are to find any intel that would lead to his whereabouts. " \n "<br/><br/> " \n "Third platoon is standing by to assist and the airforce will be flying a sortie in case we need it. " \n "";
										};
									};
								};
								class Attribute3
								{
									property="ModuleCreateDiaryRecord_F_Owner";
									expression="_this setVariable ['Owner',_value,true];";
									class Value
									{
										class data
										{
											singleType="SCALAR";
											value=3;
										};
									};
								};
								class Attribute4
								{
									property="ModuleCreateDiaryRecord_F_Subject";
									expression="_this setVariable ['Subject',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="";
										};
									};
								};
								nAttributes=5;
							};
						};
