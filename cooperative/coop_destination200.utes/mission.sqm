										class data
										{
											singleType="STRING";
											value="The CDF are the primary land, sea, and air defence force of Chernarus. Though they lack the advanced equipment of modern Western armies, they retain a significant stockpile of hardware from their days as a former Soviet territory.     " \n "<br/><br/>      " \n "The CDF is equipped primarily with Soviet-era equipment, but it large and has some well trained units.    ";
