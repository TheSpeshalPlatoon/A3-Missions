								class Attribute2
								{
									property="ModuleCreateDiaryRecord_F_Description";
									expression="_this setVariable ['Description',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="Utes is a military island of the South coast of South Zagoria, Chernarus and is a strategic CDF position, home to a <marker name='airfield_mrk'>large airfield</marker> and <marker name='missile_mrk'>missile base</marker>, it is considered a priority target for the invasion.  " \n "<br/><br/>  " \n "You are a member of a VMF frogmen platoon, tasked with securing a <marker name='beach_mrk'>beachhead</marker> for the main landing force.     " \n "<br/><br/>  " \n "The CDF's air and naval power have been disabled by close air support and naval gunfire in preparation for the ground invasion. Enemy resistance on the island is believed to be relativly light and spread out. " \n "<br/><br/>      " \n "Furthermore, a platoon sized force attempted to set up an LZ at <marker name='strelka_mrk'>Strelka</marker> but was stopped, half of the unit retreated, but the other half are MIA, you must search for any survivors.     " \n "<br/><br/>      " \n "The mission is to insert quietly by water in order to disable CDF defences on the South island, such that the <marker name='lazo_mrk'>MSC Lazo</marker> can unload their landing force.";
										};
									};
								};
								class Attribute3
								{
									property="ModuleCreateDiaryRecord_F_Owner";
									expression="_this setVariable ['Owner',_value,true];";
