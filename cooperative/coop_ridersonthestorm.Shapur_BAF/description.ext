class CfgORBAT {
	class tka {
		id = 1; idType = 0; side = "East";
		text = "Takistani Army"; textShort = "TKA"; type = "Infantry"; size = "Army"; commander = "Muhammad Aziz"; commanderRank = "General";
		description = "The Takistani Army is the principal military force of the Republic of Takistan. Built around a large Soviet-trained officer corps, the TKA maintains substantial infantry, mechanized, armoured, artillery and air defence forces. Although much of its equipment is aging, the sheer size of the force and its extensive stockpiles of Soviet-era weapons make it a significant regional military power.";
		subordinates[] = {"tka_1div","tka_2div","tka_3div","tka_artillery","tka_airdef","tka_missile","tka_logistics","tka_air","tka_sf"};
		assets[] = {};
	};
		class tka_1div: tka {
			text = "1st Takistani Infantry Division"; textShort = "1st Infantry Division"; type = "Infantry"; size = "Division"; commander = "Ahmed Khalil"; commanderRank = "Major General";
			description = "The 1st Infantry Division is one of the TKA's largest formations and forms the backbone of the army's defensive line. It consists primarily of motorized infantry supported by light armour and organic artillery.";
			subordinates[] = {"11inf","12inf","13inf","14mot","15art"};
			assets[] = {};
		};
			class 11inf: tka {
				text = "11th Infantry Brigade"; textShort = "11th Infantry"; type = "Infantry"; size = "Brigade"; commander = "Omar Hassan"; commanderRank = "Colonel";
				description = "Conventional infantry formation responsible for defensive operations and securing population centres.";
				subordinates[] = {}; assets[] = {{"UK3CB_TKA_I_UAZ_Open",20}, {"UK3CB_TKA_I_GAZ_Vodnik",10}, {"UK3CB_TKA_O_Ural",35}};
			};
			class 12inf: tka {
				text = "12th Infantry Brigade"; textShort = "12th Infantry"; type = "Infantry"; size = "Brigade"; commander = "Farid Mahmoud"; commanderRank = "Colonel";
				description = "Second-line infantry brigade maintained at high readiness to reinforce threatened sectors.";
				subordinates[] = {}; assets[] = {{"UK3CB_TKA_I_UAZ_Open",20}, {"UK3CB_TKA_I_GAZ_Vodnik",10}, {"UK3CB_TKA_O_Ural",35}};
			};
			class 13inf: tka {
				text = "13th Infantry Brigade"; textShort = "13th Infantry"; type = "Infantry"; size = "Brigade"; commander = "Hassan Karim"; commanderRank = "Colonel";
				description = "Light infantry brigade assigned primarily to mountainous and difficult terrain.";
				subordinates[] = {}; assets[] = {{"UK3CB_TKA_I_UAZ_Open",25}, {"UK3CB_TKA_I_V3S_Closed",30}, {"UK3CB_TKA_O_Ural",25}};
