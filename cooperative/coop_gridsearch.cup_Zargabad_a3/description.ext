tsp_param_skill = 1;        //-- AI skill
tsp_param_spotting = 1;    //-- AI spotting
tsp_param_brightness = 0.5; 
tsp_param_time_day = 24; 
tsp_param_time_night = 12;
tsp_param_weather = false;

