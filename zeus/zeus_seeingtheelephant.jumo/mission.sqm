					state=1;
					class Entities
					{
						items=21;
						class Item0
						{
							dataType="Logic";
							class PositionInfo
							{
								position[]={5817.8765,0,4340.146};
							};
							areaSize[]={1174.0659,0,1833.6794};
							areaIsRectangle=1;
							flags=1;
							id=215;
							type="ModuleCoverMap_F";
							atlOffset=-7.3303981;
						};
						class Item1
						{
							dataType="Logic";
							class PositionInfo
							{
								position[]={5754.4771,16.529451,4068.7781};
								angles[]={6.2581921,0,0};
							};
							id=216;
							type="ModuleCreateDiaryRecord_F";
							class CustomAttributes
							{
								class Attribute0
								{
									property="ModuleCreateDiaryRecord_F_PresetTitle";
									expression="_this setVariable ['PresetTitle',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="Situation";
										};
									};
								};
								class Attribute1
								{
									property="ModuleCreateDiaryRecord_F_Title";
									expression="_this setVariable ['Title',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="Briefing";
										};
									};
								};
								class Attribute2
								{
									property="ModuleCreateDiaryRecord_F_Description";
									expression="_this setVariable ['Description',_value,true];";
									class Value
									{
										class data
										{
											singleType="STRING";
											value="<font face='PuristaBold' color='#fce300' size='15'>SITUATION</font>     " \n "<br/>  " \n "Our forces on Kaska have been engaged in heavy combat with advancing USMC and US Army Airborne units.  " \n "<br/><br/>  " \n "The enemy has gained air superiority and is pushing us back, threatening to annihilate the entire Task Force. " \n "<br/><br/>  " \n "High command has ordered a tactical withdrawal from the Island. However, we must buy some time for our wounded comrades. " \n "<br/><br/>  " \n "The 76th Guards Razvedka has been tasked to help cover the withdrawal, delaying enemy forces long enough for most of our ships and helicopters to get out of the AO. " \n "<br/><br/>  " \n "This is the first time your unit has seen combat.  " \n "<br/><br/>  " \n "<font face='PuristaBold' color='#fce300' size='15'>ENEMY</font>     " \n "<br/>  " \n "We're dealing with US Marines and Airborne soldiers. " \n "<br/><br/>  " \n "These 'men' have proved themselves to be tough adversaries.  " \n "<br/><br/>  " \n "The Marines will use their so called 'AAVs' to land on our beaches, use your RPGs and BMD to suppress their landing. " \n "<br/><br/>  " \n "Airborne forces can come at any direction so be prepared for an air-assault, we have attached one BTR-ZD to your unit to use against their helicopters. " \n "<br/><br/>  " \n "<font face='PuristaBold' color='#fce300' size='15'>MISSION</font>     " \n "<br/>  " \n "Establish defenses at <marker name='marker_4'>Sever-2</marker> and hold off the enemy. " \n "<br/><br/>  " \n "If things get too hot, retreat to <marker name='marker_5'>Sever-1</marker>. " \n "<br/><br/>  " \n "Fall back to the <marker name='marker_7'>Secondary Evacuation Point</marker> for EXFIL once the order has been given. " \n "<br/><br/>  " \n "Further orders may come from the Battalion Commander, any questions you may ask to the Commander." \n "<br/><br/>  " \n "ACE Fortify is available for use.";
										};
									};
								};
								class Attribute3
								{
									property="ModuleCreateDiaryRecord_F_Owner";
									expression="_this setVariable ['Owner',_value,true];";
									class Value
									{
										class data
										{
											singleType="SCALAR";
											value=3;
										};
									};
								};
								class Attribute4
								{
									property="ModuleCreateDiaryRecord_F_Subject";
